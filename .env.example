# ANOOS DevSecOps platform environment variables
# Copy to .env and fill in values

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# GitHub
GITHUB_TOKEN=
GITHUB_USER=muhammedhanas

# Nexus
NEXUS_URL=http://nexus.anoos.local:8081
NEXUS_DOCKER_URL=http://nexus-docker.anoos.local:8082
NEXUS_USER=admin
NEXUS_PASSWORD=

# SonarQube
SONAR_URL=http://sonar.anoos.local:9000
SONAR_TOKEN=

# Jenkins
JENKINS_URL=http://jenkins.anoos.local:8080
JENKINS_USER=admin
JENKINS_TOKEN=

# Kubernetes
KUBECONFIG=~/.kube/config
